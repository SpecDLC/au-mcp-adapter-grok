{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "node --experimental-strip-types \"${GROK_PLUGIN_ROOT}/hooks/session-start.ts\"", "timeout": 30 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "node --experimental-strip-types \"${GROK_PLUGIN_ROOT}/hooks/user-prompt-submit.ts\"", "timeout": 30 }] }
    ],
    "PreToolUse": [
      { "matcher": ".*", "hooks": [{ "type": "command", "command": "node --experimental-strip-types \"${GROK_PLUGIN_ROOT}/hooks/pre-tool-use.ts\"", "timeout": 30 }] }
    ],
    "PostToolUse": [
      { "matcher": ".*", "hooks": [{ "type": "command", "command": "node --experimental-strip-types \"${GROK_PLUGIN_ROOT}/hooks/post-tool-use.ts\"", "timeout": 30 }] }
    ],
    "PostToolUseFailure": [
      { "matcher": ".*", "hooks": [{ "type": "command", "command": "node --experimental-strip-types \"${GROK_PLUGIN_ROOT}/hooks/post-tool-use-failure.ts\"", "timeout": 15 }] }
    ],
    "PreCompact": [
      { "hooks": [{ "type": "command", "command": "node --experimental-strip-types \"${GROK_PLUGIN_ROOT}/hooks/pre-compact.ts\"", "timeout": 15 }] }
    ],
    "SubagentStart": [
      { "hooks": [{ "type": "command", "command": "node --experimental-strip-types \"${GROK_PLUGIN_ROOT}/hooks/subagent-start.ts\"", "timeout": 15 }] }
    ],
    "SubagentStop": [
      { "hooks": [{ "type": "command", "command": "node --experimental-strip-types \"${GROK_PLUGIN_ROOT}/hooks/subagent-stop.ts\"", "timeout": 30 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node --experimental-strip-types \"${GROK_PLUGIN_ROOT}/hooks/stop.ts\"", "timeout": 30 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "node --experimental-strip-types \"${GROK_PLUGIN_ROOT}/hooks/session-end.ts\"", "timeout": 15 }] }
    ]
  }
}
